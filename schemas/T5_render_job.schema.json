  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{7,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "mime_type",
        "width",
        "height",
        "fps",
        "frame_count",
        "duration_ms",
        "source_in_ms",
        "video_codec",
        "audio_codec",
        "has_audio"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mime_type": {
          "enum": [
            "video/mp4",
            "video/webm",
            "video/quicktime"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 320
        },
        "fps": {
          "type": "number",
          "minimum": 12,
          "maximum": 120
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1000
        },
        "source_in_ms": {
          "type": "integer",
          "minimum": 0
        },
        "video_codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "audio_codec": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    }
