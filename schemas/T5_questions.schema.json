{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vitrinevideo0-bot/vitrine-video-t5-formule-combo-offre/raw/main/schemas/T5_questions.schema.json",
  "title": "RESTAURATION-T5 owner-approved merchant questions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "title",
    "status",
    "copy_revision",
    "additionalProperties",
    "fields",
    "proposal_decision",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "template_id": { "const": "RESTAURATION-T5" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "const": "owner_approved" },
    "copy_revision": { "const": "T5_6_QUESTIONS_SIMPLIFIEES_2026-11-18" },
    "additionalProperties": { "const": false },
    "fields": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/nom" },
        { "$ref": "#/$defs/offre" },
        { "$ref": "#/$defs/contenu" },
        { "$ref": "#/$defs/prix" },
        { "$ref": "#/$defs/whatsapp" },
        { "$ref": "#/$defs/quartier" }
      ],
      "items": false
    },
    "proposal_decision": {
      "type": "object",
      "required": ["question_count", "all_six_required", "why", "invented_content_forbidden"],
      "properties": {
        "question_count": { "const": 6 },
        "all_six_required": { "const": true },
        "why": { "type": "string", "minLength": 1 },
        "invented_content_forbidden": { "const": true }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["date", "decision_channel", "question_id", "selected_option_id", "decision", "scope"],
      "properties": {
        "date": { "const": "2026-11-18" },
        "decision_channel": { "const": "arena_direct_instruction" },
        "question_id": { "const": "t5_simplified_questions_update" },
        "selected_option_id": { "const": "apply_exact_user_copy" },
        "decision": { "const": "Appliquer les 6 questions simplifiées fournies par le propriétaire" },
        "scope": {
          "const": [
            "Nom du restaurant",
            "Nom de la formule",
            "Ce qu'il y a dans la formule",
            "Prix",
            "Numéro WhatsApp",
            "Lieu de retrait"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "question", "required", "minLength", "maxLength", "example", "json_target", "used_in_scenes"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "required": { "const": true },
        "minLength": { "type": "integer", "minimum": 1 },
        "maxLength": { "type": "integer", "minimum": 4 },
        "example": { "type": "string", "minLength": 1 },
        "example_items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "helper": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "json_target": { "type": "string", "pattern": "^merchant_payload\\.[a-z]+$" },
        "used_in_scenes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["S1", "S2", "S3", "S4"] }
        }
      }
    },
    "nom": {
      "allOf": [
        { "$ref": "#/$defs/field" },
        { "properties": {
          "id": { "const": "nom" },
          "label": { "const": "Nom du restaurant" },
          "question": { "const": "Comment s'appelle ton restaurant ?" },
          "example": { "const": "Burger Atelier Kandi" },
          "json_target": { "const": "merchant_payload.nom" },
          "used_in_scenes": { "const": ["S1", "S4"] }
        } }
      ]
    },
    "offre": {
      "allOf": [
        { "$ref": "#/$defs/field" },
        { "properties": {
          "id": { "const": "offre" },
          "label": { "const": "Nom de la formule" },
          "question": { "const": "Comment tu appelles cette formule ?" },
          "example": { "const": "Formule Double Burger" },
          "json_target": { "const": "merchant_payload.offre" },
          "used_in_scenes": { "const": ["S1", "S3"] }
        } }
      ]
    },
    "contenu": {
      "allOf": [
        { "$ref": "#/$defs/field" },
        { "required": ["example_items"], "properties": {
          "id": { "const": "contenu" },
          "label": { "const": "Ce qu'il y a dans la formule" },
          "question": { "const": "Dans cette formule, tu mets quoi ? Dis-nous aussi combien il y a de chaque chose." },
          "example": { "const": "1 double burger\n1 portion de frites\n1 verre de cola" },
          "example_items": { "const": ["1 double burger", "1 portion de frites", "1 verre de cola"] },
          "json_target": { "const": "merchant_payload.contenu" },
          "used_in_scenes": { "const": ["S1", "S2", "S3"] }
        } }
      ]
    },
    "prix": {
      "allOf": [
        { "$ref": "#/$defs/field" },
        { "properties": {
          "id": { "const": "prix" },
          "label": { "const": "Prix" },
          "question": { "const": "Tu vends cette formule à combien ?" },
          "example": { "const": "5 000 FCFA" },
          "json_target": { "const": "merchant_payload.prix" },
          "used_in_scenes": { "const": ["S3"] }
        } }
      ]
    },
    "whatsapp": {
      "allOf": [
        { "$ref": "#/$defs/field" },
        { "properties": {
          "id": { "const": "whatsapp" },
          "label": { "const": "Numéro WhatsApp" },
          "question": { "const": "Quel est ton numéro WhatsApp pour que les clients puissent commander ?" },
          "example": { "const": "+229 01 97 00 00 00" },
          "json_target": { "const": "merchant_payload.whatsapp" },
          "used_in_scenes": { "const": ["S4"] }
        } }
      ]
    },
    "quartier": {
      "allOf": [
        { "$ref": "#/$defs/field" },
        { "properties": {
          "id": { "const": "quartier" },
          "label": { "const": "Lieu de retrait" },
          "question": { "const": "Les clients peuvent venir chercher leur commande où ?" },
          "example": { "const": "Kandi, près du marché central" },
          "json_target": { "const": "merchant_payload.quartier" },
          "used_in_scenes": { "const": ["S4"] }
        } }
      ]
    }
  }
}
