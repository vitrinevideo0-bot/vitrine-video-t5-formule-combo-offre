{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vitrinevideo0-bot/vitrine-video-t5-formule-combo-offre/raw/main/schemas/T5_rush_manifest.schema.json",
  "title": "RESTAURATION-T5 four-capture validation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "purpose", "continuity_rule", "license", "output_contract", "transition_contract", "sources", "scenes"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "template_id": {"const": "RESTAURATION-T5"},
    "purpose": {"type": "string", "minLength": 1},
    "continuity_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_offer_per_ad", "same_dish_drink_and_sides_across_four_scenes", "same_shoot_and_creator", "demo_offer", "source_count", "visible_in_every_scene"],
      "properties": {
        "one_offer_per_ad": {"const": true},
        "same_dish_drink_and_sides_across_four_scenes": {"const": true},
        "same_shoot_and_creator": {"const": true},
        "demo_offer": {"type": "string", "minLength": 1},
        "source_count": {"const": 4},
        "visible_in_every_scene": {"const": ["double burger", "portion de frites", "verre de cola"]}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "license_url", "verified_at_utc", "summary", "raw_media_committed", "raw_media_published_as_artifact"],
      "properties": {
        "provider": {"const": "Pexels"},
        "license_url": {"const": "https://www.pexels.com/license/"},
        "verified_at_utc": {"type": "string", "format": "date"},
        "summary": {"type": "string", "minLength": 1},
        "raw_media_committed": {"const": false},
        "raw_media_published_as_artifact": {"const": false}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "duration_seconds", "total_frames", "video_codec", "pixel_format", "audio_streams", "burned_text_source", "production_render_plane"],
      "properties": {
        "width": {"const": 720},
        "height": {"const": 1280},
        "fps": {"const": 30},
        "duration_seconds": {"const": 30.0},
        "total_frames": {"const": 900},
        "video_codec": {"const": "h264"},
        "pixel_format": {"const": "yuv420p"},
        "audio_streams": {"const": 0},
        "burned_text_source": {"const": "merchant_payload"},
        "production_render_plane": {"const": "github_actions"}
      }
    },
    "transition_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "family", "duration_frames", "boundary_frames", "variants"],
      "properties": {
        "reference": {"const": "T1"},
        "family": {"const": "dish_swipe"},
        "duration_frames": {"const": 8},
        "boundary_frames": {"const": [180, 420, 630]},
        "variants": {"const": ["slideleft", "slideright", "slideleft"]}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/sourceS1"},
        {"$ref": "#/$defs/sourceS2"},
        {"$ref": "#/$defs/sourceS3"},
        {"$ref": "#/$defs/sourceS4"}
      ],
      "items": false
    },
    "scenes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/sceneS1"},
        {"$ref": "#/$defs/sceneS2"},
        {"$ref": "#/$defs/sceneS3"},
        {"$ref": "#/$defs/sceneS4"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "pexels_id", "creator", "page_title", "page_url", "download_url", "cache_filename", "expected_bytes", "sha256", "width", "height", "fps", "frame_count", "duration_ms", "visible_items", "scene_fit"],
      "properties": {
        "slot": {"type": "string"},
        "pexels_id": {"type": "integer", "minimum": 1},
        "creator": {"const": "Artem Podrez"},
        "page_title": {"type": "string", "minLength": 1},
        "page_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.pexels\\.com/"},
        "download_url": {"type": "string", "format": "uri", "pattern": "^https://videos\\.pexels\\.com/"},
        "cache_filename": {"type": "string", "pattern": "^S[1-4]_[0-9]+\\.mp4$"},
        "expected_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"const": 2560},
        "height": {"const": 1440},
        "fps": {"const": 30.0},
        "frame_count": {"type": "integer", "minimum": 180},
        "duration_ms": {"type": "integer", "minimum": 6000},
        "visible_items": {"const": ["double burger", "portion de frites", "verre de cola"]},
        "scene_fit": {"type": "string", "minLength": 1}
      }
    },
    "sourceS1": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"slot": {"const": "S1"}, "pexels_id": {"const": 4731057}}}]},
    "sourceS2": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"slot": {"const": "S2"}, "pexels_id": {"const": 4731063}}}]},
    "sourceS3": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"slot": {"const": "S3"}, "pexels_id": {"const": 4731066}}}]},
    "sourceS4": {"allOf": [{"$ref": "#/$defs/source"}, {"properties": {"slot": {"const": "S4"}, "pexels_id": {"const": 4731132}}}]},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "title", "duration_seconds", "source_slot", "source_in_ms", "freeze_tail_ms"],
      "properties": {
        "scene": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "source_slot": {"type": "string"},
        "source_in_ms": {"type": "integer", "minimum": 0},
        "freeze_tail_ms": {"type": "integer", "minimum": 0}
      }
    },
    "sceneS1": {"allOf": [{"$ref": "#/$defs/scene"}, {"properties": {"scene": {"const": "S1"}, "title": {"const": "LA FORMULE"}, "duration_seconds": {"const": 6}, "source_slot": {"const": "S1"}, "freeze_tail_ms": {"const": 0}}}]},
    "sceneS2": {"allOf": [{"$ref": "#/$defs/scene"}, {"properties": {"scene": {"const": "S2"}, "title": {"const": "CE QU’IL Y A DANS LA FORMULE"}, "duration_seconds": {"const": 8}, "source_slot": {"const": "S2"}, "freeze_tail_ms": {"const": 0}}}]},
    "sceneS3": {"allOf": [{"$ref": "#/$defs/scene"}, {"properties": {"scene": {"const": "S3"}, "title": {"const": "LE PRIX"}, "duration_seconds": {"const": 7}, "source_slot": {"const": "S3"}, "freeze_tail_ms": {"const": 0}}}]},
    "sceneS4": {"allOf": [{"$ref": "#/$defs/scene"}, {"properties": {"scene": {"const": "S4"}, "title": {"const": "COMMANDER"}, "duration_seconds": {"const": 9}, "source_slot": {"const": "S4"}, "freeze_tail_ms": {"const": 3000}}}]}
  }
}
