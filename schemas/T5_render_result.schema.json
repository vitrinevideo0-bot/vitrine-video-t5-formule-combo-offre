  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{7,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "capture_slot",
        "capture_sha256",
        "timeline_start_frame",
        "timeline_end_frame"
      ],
      "properties": {
        "scene": {
          "type": "string"
        },
        "capture_slot": {
          "type": "string"
        },
        "capture_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "timeline_start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "timeline_end_frame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bindingS1": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "scene": {
              "const": "S1"
