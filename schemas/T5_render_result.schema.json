  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "audio_quality",
          "audio",
          "audio_state_commit_allowed"
        ],
        "properties": {
          "profile_used": {
            "const": "T5_GITHUB_ACTIONS_COMPLETE_V1"
          },
          "inputs": {
            "required": [
              "merchant_payload_sha256",
              "capture_sha256",
              "runtime_manifest_sha256",
              "resolved_text_sha256",
              "audio_contract_sha256",
              "music_pack_sha256",
              "music_source_sha256",
              "music_program_sha256",
              "voice_manifest_sha256",
              "voice_clip_source_sha256"
            ]
