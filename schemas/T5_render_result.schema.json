            "timeline_end_frame": {
              "const": 419
            }
          }
        }
      ]
    },
    "bindingS3": {
      "allOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "properties": {
            "scene": {
              "const": "S3"
            },
            "capture_slot": {
              "const": "S3"
            },
            "timeline_start_frame": {
              "const": 420
            },
            "timeline_end_frame": {
              "const": 629
            }
          }
